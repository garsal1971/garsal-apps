<?xml version="1.0" encoding="utf-8"?>
<!-- Il logo di AppSphere per la BARRA IN ALTO: gli stessi cinque cerchi di
     `ic_launcher_foreground.xml`, su un disco bianco.

     ⚠️ Il disco non è decorazione. La barra è blu (#0081C8) e il cerchio
     centrale del marchio è blu (#067BC0): senza un fondo dietro, il pezzo che
     regge tutto il disegno sparisce nel colore della barra. Sul launcher il
     fondo ce l'ha già — bianco per l'APK WebView, nero per quello nativo.

     ⚠️ La geometria è quella del launcher riportata in scala: là i cerchi hanno
     r 14 su una tela da 108 con i centri a ±14 dal mezzo; qui r 12 su 64 con i
     centri a ±12, cioè lo stesso disegno rimpicciolito per lasciare il margine
     bianco. Se cambia il marchio, cambia in tutti e tre i posti — questo file,
     i due `ic_launcher_foreground.xml`, e l'SVG nella barra delle pagine. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">

    <!-- il disco bianco -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M32,32 m-32,0 a32,32 0 1,0 64,0 a32,32 0 1,0 -64,0" />

    <!-- arancio, in alto a sinistra -->
    <path
        android:fillColor="#DE8026"
        android:pathData="M20,20 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- rosso, in alto a destra -->
    <path
        android:fillColor="#CA372E"
        android:pathData="M44,20 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- verde, in basso a sinistra -->
    <path
        android:fillColor="#32974C"
        android:pathData="M20,44 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- viola, in basso a destra -->
    <path
        android:fillColor="#824FA5"
        android:pathData="M44,44 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />

    <!-- blu, al centro e sopra a tutti -->
    <path
        android:fillColor="#067BC0"
        android:pathData="M32,32 m-12,0 a12,12 0 1,0 24,0 a12,12 0 1,0 -24,0" />
</vector>
